pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '15'))
  }

  environment {
    IMAGE = 'rohithdockerr/food-delivery'
    ANSIBLE_HOST_KEY_CHECKING = 'False'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          env.IMAGE_TAG = "${env.BUILD_NUMBER}-${sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()}"
        }
      }
    }

    stage('Validate website') {
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          test -s food-delivery-azure/index.html
          test -s food-delivery-azure/styles.css
          test -s food-delivery-azure/app.js
        '''
      }
    }

    stage('Build image') {
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          docker build --pull -f food-delivery-ops/Dockerfile \
            --tag "$IMAGE:$IMAGE_TAG" --tag "$IMAGE:latest" .
        '''
      }
    }

    stage('Smoke test') {
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          docker rm -f food-delivery-smoke >/dev/null 2>&1 || true
          docker run -d --rm --name food-delivery-smoke -p 18080:80 "$IMAGE:$IMAGE_TAG"
          trap 'docker rm -f food-delivery-smoke >/dev/null 2>&1 || true' EXIT
          for attempt in {1..20}; do
            curl --fail --silent http://127.0.0.1:18080/ >/dev/null && exit 0
            sleep 1
          done
          exit 1
        '''
      }
    }

    stage('Publish image') {
      when { branch 'main' }
      steps {
        withCredentials([usernamePassword(credentialsId: 'dockerhub-rohithdockerr', usernameVariable: 'DOCKERHUB_USERNAME', passwordVariable: 'DOCKERHUB_TOKEN')]) {
          sh '''#!/usr/bin/env bash
            set -euo pipefail
            test "$DOCKERHUB_USERNAME" = "rohithdockerr"
            echo "$DOCKERHUB_TOKEN" | docker login --username "$DOCKERHUB_USERNAME" --password-stdin
            docker push "$IMAGE:$IMAGE_TAG"
            docker push "$IMAGE:latest"
            docker logout
          '''
        }
      }
    }

    stage('Deploy with Ansible') {
      when { branch 'main' }
      steps {
        withCredentials([sshUserPrivateKey(credentialsId: 'food-delivery-ssh-key', keyFileVariable: 'ANSIBLE_SSH_KEY', usernameVariable: 'ANSIBLE_USER')]) {
          sh '''#!/usr/bin/env bash
            set -euo pipefail
            ansible-playbook -i food-delivery-ops/ansible/inventory.ini \
              food-delivery-ops/ansible/deploy.yml \
              --extra-vars "image_name=$IMAGE:$IMAGE_TAG ansible_user=$ANSIBLE_USER ansible_ssh_private_key_file=$ANSIBLE_SSH_KEY"
          '''
        }
      }
    }
  }
}

